# --- WapiLeo environment variables ---
# Copy to .env for local development and set the same values in the Vercel
# dashboard (Project Settings -> Environment Variables) for production.

# Pooled connection string used by the app at runtime.
# Prisma Postgres, Neon, and Supabase all provide a pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Direct (non-pooled) connection used by `prisma migrate`.
# If you are NOT using a connection pooler, set this equal to DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
